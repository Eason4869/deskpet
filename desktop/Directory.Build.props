<Project>
  <PropertyGroup>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../src/ReleaseInfo.cs')), 'DisplayVersion=&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../src/ReleaseInfo.cs')), 'AssemblyVersion=&quot;([^&quot;]+)&quot;').Groups[1].Value)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
</Project>
